---
import { experience, earlier } from "../data/content";
---

<section class="section exp" id="experience">
  <div class="wrap">
    <header class="sec-head reveal">
      <p class="eyebrow" data-num="01">Experience</p>
      <h2 class="section-title">A decade of building, shipping &amp; scaling.</h2>
    </header>

    <ol class="timeline">
      {experience.map((job, i) => (
        <li class={`job reveal ${job.accent ? "is-accent" : ""}`} data-cursor-hover>
          <div class="job-rail" aria-hidden="true"><span class="node"></span></div>
          <div class="job-body">
            <div class="job-top">
              <h3 class="job-company">{job.company}</h3>
              <span class="job-period">{job.period}</span>
            </div>
            <p class="job-role">{job.role} <span class="job-loc">· {job.location}</span></p>
            <p class="job-prog">{job.progression}</p>
            <p class="job-blurb">{job.blurb}</p>
            <ul class="job-points">
              {job.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
            {job.links.length > 0 && (
              <div class="job-links">
                {job.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener noreferrer">
                    {l.label}
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                ))}
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>

    <p class="earlier reveal">{earlier}</p>
  </div>
</section>

<style>
  .sec-head { margin-bottom: clamp(2.5rem, 6vh, 4.5rem); }

  .timeline { list-style: none; padding: 0; margin: 0; }

  .job {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: clamp(1rem, 3vw, 2.4rem);
    padding-block: clamp(2rem, 4vh, 3rem);
    border-top: 1px solid var(--line);
    position: relative;
  }
  .job:last-of-type { border-bottom: 1px solid var(--line); }

  .job-rail { position: relative; }
  .job-rail::before {
    content: "";
    position: absolute;
    left: 50%; top: 0.55rem; bottom: -3rem;
    width: 1px;
    background: var(--line-strong);
    translate: -50% 0;
  }
  .job:last-of-type .job-rail::before { display: none; }
  .node {
    position: absolute;
    left: 50%; top: 0.55rem;
    width: 11px; height: 11px;
    border-radius: 50%;
    translate: -50% 0;
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
    transition: background 0.4s var(--ease), box-shadow 0.4s var(--ease), border-color 0.4s var(--ease);
  }
  .is-accent .node {
    background: var(--ember);
    border-color: transparent;
    box-shadow: 0 0 16px rgba(233, 161, 75, 0.6);
  }
  .job:hover .node {
    background: var(--ember);
    border-color: transparent;
    box-shadow: 0 0 16px rgba(233, 161, 75, 0.55);
  }

  .job-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .job-company {
    font-size: var(--step-2);
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .is-accent .job-company { color: var(--text); }
  .job-period {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    white-space: nowrap;
  }
  .job-role {
    margin-top: 0.4rem;
    font-size: var(--step-1);
    color: var(--accent-hi);
  }
  .job-loc { color: var(--muted); font-size: var(--step-0); }
  .job-prog {
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--faint);
    letter-spacing: 0.01em;
  }
  .job-blurb {
    margin-top: 1.1rem;
    max-width: 60ch;
    color: var(--text-dim);
  }
  .job-points {
    margin-top: 1.2rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
    max-width: 64ch;
  }
  .job-points li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--text-dim);
    font-size: var(--step-0);
    line-height: 1.5;
  }
  .job-points li::before {
    content: "";
    position: absolute;
    left: 0; top: 0.62em;
    width: 7px; height: 1px;
    background: var(--accent);
  }
  .job-links {
    margin-top: 1.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .job-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: var(--step--1);
    color: var(--text-dim);
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease), background 0.3s var(--ease);
  }
  .job-links a:hover {
    color: var(--text);
    border-color: var(--accent);
    background: rgba(233, 161, 75, 0.08);
  }
  .job-links svg { opacity: 0.7; }

  .earlier {
    margin-top: 2rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  @media (max-width: 560px) {
    .job { grid-template-columns: 16px 1fr; }
  }
</style>
