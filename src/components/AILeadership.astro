---
import { aiLeadership } from "../data/content";
---

<section class="section ai" id="ai">
  <div class="ai-glow" aria-hidden="true"></div>
  <div class="wrap">
    <header class="sec-head reveal">
      <p class="eyebrow" data-num="03">AI Leadership</p>
      <h2 class="section-title">A product leader who <em>builds</em> the AI, not just briefs it.</h2>
      <p class="lead ai-intro">{aiLeadership.intro}</p>
    </header>

    <ul class="ai-outcomes reveal" aria-label="AI outcomes">
      {aiLeadership.outcomes.map((o) => (
        <li class="outcome">
          <span class="outcome-metric accent-text">{o.metric}</span>
          <span class="outcome-label">{o.label}</span>
        </li>
      ))}
    </ul>

    <div class="ai-grid">
      {aiLeadership.cards.map((c, i) => (
        <article class="ai-card reveal" data-delay={(i % 2) + 1} data-cursor-hover>
          <div class="card-spot" aria-hidden="true"></div>
          <p class="card-kicker">{c.kicker}</p>
          <h3 class="card-title">{c.title}</h3>
          <p class="card-body">{c.body}</p>
          <span class="card-index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .ai {
    position: relative;
    background: linear-gradient(180deg, var(--bg-2), var(--bg) 80%);
    overflow: hidden;
  }
  .ai-glow {
    position: absolute;
    top: -20%; left: 50%;
    width: 70vw; height: 60vh;
    translate: -50% 0;
    background: radial-gradient(circle, rgba(233,161,75,0.14), transparent 60%);
    filter: blur(40px);
    pointer-events: none;
  }
  .ai-intro { margin-top: 1.4rem; max-width: 60ch; }
  .section-title em {
    font-style: italic;
    background: var(--ember);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .ai-outcomes {
    list-style: none;
    padding: clamp(1.4rem, 3vw, 2rem) 0;
    margin-top: clamp(2rem, 5vh, 3rem);
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(1rem, 2.5vw, 2rem);
    border-block: 1px solid var(--line);
  }
  .outcome { display: flex; flex-direction: column; gap: 0.45rem; }
  .outcome-metric {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1rem + 1.6vw, 2.2rem);
    font-weight: 360;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .outcome-label { color: var(--muted); font-size: var(--step--1); line-height: 1.4; }

  .ai-grid {
    margin-top: clamp(2.5rem, 6vh, 4rem);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1rem, 2vw, 1.4rem);
  }
  @media (max-width: 900px) { .ai-outcomes { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 460px) { .ai-outcomes { grid-template-columns: 1fr; } }
  .ai-card {
    position: relative;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(160deg, rgba(30,26,19,0.7), rgba(18,15,11,0.4));
    overflow: hidden;
    transition: border-color 0.4s var(--ease), transform 0.4s var(--ease);
  }
  .ai-card:hover { border-color: var(--line-strong); transform: translateY(-4px); }
  .card-spot {
    position: absolute;
    width: 320px; height: 320px;
    background: radial-gradient(circle, rgba(233,161,75,0.16), transparent 65%);
    left: var(--mx, 50%); top: var(--my, 0%);
    translate: -50% -50%;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
    pointer-events: none;
  }
  .ai-card:hover .card-spot { opacity: 1; }

  .card-kicker {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .card-title {
    margin-top: 0.8rem;
    font-size: var(--step-2);
    font-weight: 380;
    max-width: 18ch;
  }
  .card-body {
    margin-top: 0.9rem;
    color: var(--text-dim);
    max-width: 46ch;
    position: relative;
    z-index: 1;
  }
  .card-index {
    position: absolute;
    right: 1.2rem; bottom: 0.4rem;
    font-family: var(--font-display);
    font-size: 4rem;
    color: rgba(244,237,226,0.04);
    line-height: 1;
  }

  @media (max-width: 720px) {
    .ai-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Spotlight follows the cursor inside each AI card
  if (window.matchMedia("(hover: hover)").matches) {
    document.querySelectorAll<HTMLElement>(".ai-card").forEach((card) => {
      card.addEventListener("mousemove", (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty("--mx", `${e.clientX - r.left}px`);
        card.style.setProperty("--my", `${e.clientY - r.top}px`);
      });
    });
  }
</script>
