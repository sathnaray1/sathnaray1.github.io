---
import { writing } from "../data/content";
---

<section class="section writing" id="writing">
  <div class="wrap">
    <header class="sec-head reveal">
      <p class="eyebrow" data-num="03">Writing &amp; Talks</p>
      <h2 class="section-title">Perspectives on experimentation, AI &amp; the future of product.</h2>
    </header>

    <div class="write-list">
      {writing.map((w, i) => (
        <a class="write-row reveal" href={w.href} target="_blank" rel="noopener noreferrer" data-cursor-hover>
          <span class="write-index">{String(i + 1).padStart(2, "0")}</span>
          <span class="write-main">
            <span class="write-kicker">{w.kicker}</span>
            <span class="write-title">{w.title}</span>
            <span class="write-desc">{w.desc}</span>
          </span>
          <span class="write-arrow" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .write-list {
    margin-top: clamp(2rem, 5vh, 3.5rem);
    border-top: 1px solid var(--line);
  }
  .write-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.4rem);
    padding-block: clamp(1.5rem, 3.5vh, 2.4rem);
    border-bottom: 1px solid var(--line);
    position: relative;
    transition: padding-left 0.4s var(--ease);
  }
  .write-row::before {
    content: "";
    position: absolute;
    left: 0; top: 0;
    width: 0; height: 100%;
    background: linear-gradient(90deg, rgba(233,161,75,0.08), transparent);
    transition: width 0.5s var(--ease);
    z-index: -1;
  }
  .write-row:hover { padding-left: 1.2rem; }
  .write-row:hover::before { width: 100%; }

  .write-index {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--faint);
    align-self: start;
    padding-top: 0.4rem;
  }
  .write-kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .write-title {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 380;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--text);
    transition: color 0.3s var(--ease);
    max-width: 26ch;
  }
  .write-row:hover .write-title { color: var(--accent-hi); }
  .write-desc {
    display: block;
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: var(--step-0);
    max-width: 52ch;
  }
  .write-arrow {
    color: var(--text-dim);
    transition: transform 0.35s var(--ease), color 0.35s var(--ease);
  }
  .write-row:hover .write-arrow { transform: translate(4px, -4px); color: var(--accent); }

  @media (max-width: 560px) {
    .write-row { grid-template-columns: auto 1fr; }
    .write-arrow { grid-column: 2; justify-self: start; margin-top: 0.5rem; }
  }
</style>
