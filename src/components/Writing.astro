---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { writing } from "../data/content";

const imgs = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/writing/*.png",
  { eager: true }
);
const img = (file: string) => imgs[`../assets/writing/${file}`]?.default;
---

<section class="section writing" id="writing">
  <div class="wrap">
    <header class="sec-head reveal">
      <p class="eyebrow" data-num="04">Writing &amp; Talks</p>
      <h2 class="section-title">Perspectives on experimentation, AI &amp; the future of product.</h2>
    </header>

    <div class="write-grid">
      {writing.map((w, i) => (
        <a class="write-card reveal" href={w.href} target="_blank" rel="noopener noreferrer" data-delay={(i % 3) + 1} data-cursor-hover>
          {img(w.img) && (
            <div class="write-thumb">
              <Image src={img(w.img)!} alt={w.title} widths={[400, 700]} sizes="(max-width:760px) 90vw, 380px" loading="lazy" />
            </div>
          )}
          <div class="write-body">
            <span class="write-kicker">{w.kicker}</span>
            <h3 class="write-title">{w.title}</h3>
            <p class="write-desc">{w.desc}</p>
            <span class="write-read">Read <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .write-grid {
    margin-top: clamp(2rem, 5vh, 3.5rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .write-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: linear-gradient(160deg, rgba(30,26,19,0.5), rgba(18,15,11,0.3));
    transition: border-color 0.4s var(--ease), transform 0.4s var(--ease);
  }
  .write-card:hover { border-color: var(--accent); transform: translateY(-5px); }
  .write-thumb { aspect-ratio: 1200 / 750; overflow: hidden; border-bottom: 1px solid var(--line); }
  .write-thumb :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .write-card:hover .write-thumb :global(img) { transform: scale(1.04); }
  .write-body { padding: clamp(1.2rem, 2.4vw, 1.6rem); display: flex; flex-direction: column; flex: 1; }
  .write-kicker { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); }
  .write-title { margin-top: 0.7rem; font-size: var(--step-1); font-weight: 400; line-height: 1.15; letter-spacing: -0.01em; color: var(--text); transition: color 0.3s var(--ease); }
  .write-card:hover .write-title { color: var(--accent-hi); }
  .write-desc { margin-top: 0.6rem; color: var(--muted); font-size: var(--step-0); line-height: 1.5; flex: 1; }
  .write-read { margin-top: 1.1rem; display: inline-flex; align-items: center; gap: 0.4rem; font-family: var(--font-mono); font-size: var(--step--1); color: var(--text-dim); transition: color 0.3s var(--ease); }
  .write-read svg { transition: transform 0.3s var(--ease); }
  .write-card:hover .write-read { color: var(--accent); }
  .write-card:hover .write-read svg { transform: translate(3px, -3px); }

  @media (max-width: 760px) { .write-grid { grid-template-columns: 1fr; } }
</style>
