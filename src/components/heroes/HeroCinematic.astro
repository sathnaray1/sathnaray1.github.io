---
import { Image } from "astro:assets";
import bg from "../../assets/travel/clouds.jpg";
import { hero, profile } from "../../data/content";
---

<section class="hero hero-cinematic" id="top">
  <div class="bg" aria-hidden="true">
    <Image src={bg} alt="" widths={[1200, 1800, 2400]} sizes="100vw" loading="eager" class="bg-img" />
    <div class="bg-shade"></div>
    <div class="bg-ember"></div>
  </div>

  <div class="wrap hero-inner">
    <p class="eyebrow hero-eyebrow"><span class="dot"></span>Experimentation · Analytics · AI</p>
    <h1 class="hero-title">
      {hero.lines.map((line) => (
        <span class="line">{line.map((seg) => (seg.em ? <span class="em">{seg.t}</span> : seg.t))}</span>
      ))}
    </h1>
    <p class="hero-lead">{hero.subline}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#experience" data-magnetic data-cursor-hover>
        View the work
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a class="btn btn-ghost" href={profile.resume} download data-magnetic data-cursor-hover>Download résumé</a>
    </div>
    <p class="hero-meta"><span>{profile.role} · Optimizely</span><span class="sep">/</span><span>{profile.location}</span></p>
  </div>

  <a class="scroll-cue" href="#stats" aria-label="Scroll down"><span>Scroll</span><span class="cue-line"></span></a>
</section>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; padding: 6rem 0 clamp(3.5rem, 9vh, 7rem); }
  .hero-inner { position: relative; z-index: 3; flex: 1 1 auto; min-width: 0; }

  .bg { position: absolute; inset: 0; z-index: 0; }
  .bg-img { width: 100%; height: 116%; object-fit: cover; object-position: center 35%; will-change: transform; }
  /* legibility + mood */
  .bg-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,7,6,0.55) 0%, rgba(8,7,6,0.35) 35%, rgba(8,7,6,0.82) 100%); }
  .bg-ember { position: absolute; inset: 0; background: radial-gradient(80% 60% at 75% 8%, rgba(233,161,75,0.28), transparent 55%); mix-blend-mode: screen; }

  .hero-eyebrow { opacity: 0; animation: fadeUp 0.8s var(--ease-out) 0.15s forwards; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px var(--accent); }

  .hero-title { font-size: var(--step-5); font-weight: 360; line-height: 1.05; margin-top: 1.4rem; max-width: 18ch; letter-spacing: -0.03em; overflow-wrap: break-word; text-shadow: 0 2px 40px rgba(0,0,0,0.5); }
  .hero-title .line { display: block; opacity: 0; transform: translateY(0.42em); animation: lineUp 0.9s var(--ease-out) forwards; }
  .hero-title .em { font-style: italic; font-weight: 340; background: var(--ember); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .line:nth-child(1) { animation-delay: 0.3s; } .line:nth-child(2) { animation-delay: 0.44s; } .line:nth-child(3) { animation-delay: 0.58s; }

  .hero-lead { margin-top: 1.6rem; max-width: 54ch; color: var(--text-dim); font-size: var(--step-1); line-height: 1.5; opacity: 0; animation: fadeUp 0.9s var(--ease-out) 0.8s forwards; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 2.2rem; opacity: 0; animation: fadeUp 0.9s var(--ease-out) 0.95s forwards; }
  .hero-meta { display: flex; align-items: center; gap: 1rem; margin-top: 2.2rem; font-family: var(--font-mono); font-size: var(--step--1); color: var(--text-dim); opacity: 0; animation: fadeUp 0.9s var(--ease-out) 1.1s forwards; }
  .sep { color: var(--faint); }

  .scroll-cue { position: absolute; bottom: 1.4rem; left: 50%; translate: -50% 0; z-index: 3; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-dim); opacity: 0; animation: fadeUp 0.9s var(--ease-out) 1.25s forwards; }
  .cue-line { width: 1px; height: 38px; background: linear-gradient(var(--accent), transparent); position: relative; overflow: hidden; }
  .cue-line::after { content: ""; position: absolute; inset: 0; background: var(--accent); animation: cue 1.8s var(--ease) infinite; }
  @keyframes cue { 0% { transform: translateY(-100%); } 100% { transform: translateY(100%); } }

  @keyframes fadeUp { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes lineUp { to { opacity: 1; transform: translateY(0); } }

  @media (prefers-reduced-motion: reduce) {
    .hero-title .line, .hero-eyebrow, .hero-lead, .hero-actions, .hero-meta, .scroll-cue { opacity: 1; transform: none; animation: none; }
    .cue-line::after { animation: none; }
  }
  @media (max-width: 640px) {
    .hero-title { font-size: clamp(2.4rem, 8.4vw, 3.3rem); max-width: 100%; }
    .hero-eyebrow { flex-wrap: wrap; letter-spacing: 0.16em; font-size: 0.68rem; }
    .hero-lead { font-size: var(--step-0); }
  }
</style>

<script>
  // Subtle parallax on the background image
  const img = document.querySelector<HTMLElement>(".hero-cinematic .bg-img");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (img && !reduce) {
    const onScroll = () => {
      const y = window.scrollY;
      if (y < window.innerHeight) img.style.transform = `translateY(${y * 0.18}px) scale(1.02)`;
    };
    document.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
