---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { givingBack, volunteering, travel, passions } from "../data/content";
import Globe from "./Globe.astro";

// Optimize all travel/volunteering images at build time
const imgs = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/travel/*.{jpg,jpeg}",
  { eager: true }
);
const img = (file: string) => imgs[`../assets/travel/${file}`]?.default;
---

<section class="section beyond" id="beyond">
  <div class="wrap">
    <header class="sec-head reveal">
      <p class="eyebrow" data-num="06">Beyond the Work</p>
      <h2 class="section-title">Curious, multi-hyphenate, always learning.</h2>
    </header>

    <!-- Giving Back -->
    <div class="block">
      <h3 class="block-h reveal">Giving back</h3>
      <p class="block-intro reveal">{givingBack.intro}</p>
      <div class="vol-grid">
        {volunteering.map((v, i) => (
          <article class={`vol reveal ${v.img ? "has-img" : ""}`} data-delay={(i % 3) + 1} data-cursor-hover>
            {v.img && img(v.img) && (
              <div class="vol-photo">
                <Image src={img(v.img)!} alt={v.org} widths={[360, 560, 720]} sizes="(max-width:860px) 90vw, 360px" loading="lazy" />
              </div>
            )}
            <div class="vol-text">
              <p class="vol-period">{v.period}</p>
              <h4 class="vol-role">{v.role}</h4>
              <p class="vol-org">{v.org}</p>
              <p class="vol-blurb">{v.blurb}</p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Travel gallery -->
    <div class="block">
      <div class="travel-head reveal">
        <h3 class="block-h">On the move</h3>
        <div class="travel-stat">
          <span class="big-num accent-text">{travel.countries}+</span>
          <span class="big-cap">countries<br />and counting</span>
        </div>
      </div>
      <p class="block-intro reveal">{travel.intro}</p>
      <Globe />
      <div class="gallery reveal">
        {travel.gallery.map((g) => img(g.file) && (
          <figure class="shot" data-cursor-hover>
            <Image
              src={img(g.file)!}
              alt={g.place || g.caption}
              widths={[400, 700, 1000]}
              sizes="(max-width:560px) 90vw, (max-width:900px) 45vw, 30vw"
              loading="lazy"
            />
            <figcaption>
              <span class="cap">{g.caption}</span>
              {g.place && <span class="cap-place">{g.place}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>

    <!-- Off the clock -->
    <div class="block">
      <h3 class="block-h reveal">Off the clock</h3>
      <div class="passion-grid">
        {passions.items.map((p, i) => (
          <article class="passion reveal" data-delay={(i % 4) + 1}>
            <h4 class="passion-h">{p.title}</h4>
            <p class="passion-b">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .block { margin-top: clamp(3rem, 7vh, 5rem); }
  .block:first-of-type { margin-top: clamp(2.5rem, 6vh, 4rem); }
  .block-h {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 360;
    font-style: italic;
    color: var(--accent-hi);
    margin-bottom: 1.6rem;
  }
  .block-intro { color: var(--text-dim); max-width: 54ch; margin-bottom: 1.8rem; font-size: var(--step-1); }

  /* — Giving back: cards (photo on Peru card) — */
  .vol-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.4rem);
    align-items: start;
  }
  .vol {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(160deg, rgba(30,26,19,0.5), rgba(18,15,11,0.3));
    transition: border-color 0.4s var(--ease), transform 0.4s var(--ease);
    overflow: hidden;
  }
  .vol:hover { border-color: var(--line-strong); transform: translateY(-4px); }
  .vol-text { padding: clamp(1.3rem, 2.5vw, 1.8rem); }
  .vol-photo { aspect-ratio: 4 / 3; overflow: hidden; border-bottom: 1px solid var(--line); }
  .vol-photo :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: center 28%;
    transition: transform 0.6s var(--ease);
  }
  .vol.has-img:hover .vol-photo :global(img) { transform: scale(1.05); }
  .vol-period {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .vol-role { margin-top: 0.6rem; font-size: var(--step-1); font-weight: 400; line-height: 1.2; }
  .vol-org { margin-top: 0.3rem; color: var(--accent); font-size: var(--step--1); }
  .vol-blurb { margin-top: 0.7rem; color: var(--text-dim); font-size: var(--step-0); line-height: 1.5; max-width: 52ch; }

  /* — Travel head + stat — */
  .travel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .travel-head .block-h { margin-bottom: 0; }
  .travel-stat { display: flex; align-items: center; gap: 0.7rem; }
  .big-num {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 1.6rem + 3vw, 3.6rem);
    font-weight: 360;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .big-cap {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    line-height: 1.2;
    text-transform: lowercase;
  }

  /* — Travel gallery (masonry via CSS columns) — */
  .gallery {
    columns: 3;
    column-gap: clamp(0.8rem, 1.6vw, 1.2rem);
  }
  .shot {
    position: relative;
    margin: 0 0 clamp(0.8rem, 1.6vw, 1.2rem);
    break-inside: avoid;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .shot :global(img) {
    width: 100%; height: auto; display: block;
    transition: transform 0.7s var(--ease);
    filter: saturate(1.02);
  }
  .shot::after {
    content: "";
    position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 52%, rgba(8,7,6,0.82));
    opacity: 0.5;
    transition: opacity 0.5s var(--ease);
    pointer-events: none;
  }
  .shot figcaption {
    position: absolute;
    left: 1rem; bottom: 0.85rem; right: 1rem;
    z-index: 2;
    transform: translateY(6px);
    opacity: 0;
    transition: transform 0.45s var(--ease), opacity 0.45s var(--ease);
  }
  .shot .cap {
    display: block;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--text);
    line-height: 1.1;
  }
  .shot .cap-place {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: var(--accent-hi);
  }
  .shot .cap-place::before {
    content: "";
    width: 7px; height: 7px;
    border-radius: 50% 50% 50% 0; rotate: -45deg;
    background: var(--ember);
  }
  .shot:hover :global(img) { transform: scale(1.06); }
  .shot:hover::after { opacity: 0.9; }
  .shot:hover figcaption { transform: none; opacity: 1; }

  /* — Passions — */
  .passion-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2vw, 1.4rem);
  }
  .passion {
    padding-top: 1.3rem;
    border-top: 1px solid var(--line-strong);
  }
  .passion-h { font-size: var(--step-1); font-weight: 400; color: var(--text); }
  .passion-b { margin-top: 0.6rem; color: var(--text-dim); font-size: var(--step-0); line-height: 1.5; }

  @media (max-width: 860px) {
    .vol-grid { grid-template-columns: 1fr; }
    .vol.has-img .vol-photo { aspect-ratio: 16 / 9; }
    .gallery { columns: 2; }
    .passion-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .gallery { columns: 1; }
    .passion-grid { grid-template-columns: 1fr; }
  }
</style>
