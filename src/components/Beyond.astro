---
import { volunteering, travel, passions } from "../data/content";
---

<section class="section beyond" id="beyond">
  <div class="wrap">
    <header class="sec-head reveal">
      <p class="eyebrow" data-num="05">Beyond the Work</p>
      <h2 class="section-title">Curious, multi-hyphenate, always learning.</h2>
    </header>

    <!-- Giving Back -->
    <div class="block">
      <h3 class="block-h reveal">Giving back</h3>
      <div class="vol-grid">
        {volunteering.map((v, i) => (
          <article class="vol reveal" data-delay={(i % 3) + 1} data-cursor-hover>
            <p class="vol-period">{v.period}</p>
            <h4 class="vol-role">{v.role}</h4>
            <p class="vol-org">{v.org}</p>
            <p class="vol-blurb">{v.blurb}</p>
          </article>
        ))}
      </div>
    </div>

    <!-- Travel -->
    <div class="block">
      <h3 class="block-h reveal">On the move</h3>
      <p class="block-intro reveal">{travel.intro}</p>
      <ul class="travel-strip reveal">
        {travel.places.map((p) => (
          <li class="place" data-cursor-hover>
            <span class="pin" aria-hidden="true"></span>
            <span class="place-name">{p.place}</span>
            <span class="place-note">{p.note}</span>
          </li>
        ))}
      </ul>
      <p class="edit-hint reveal">More destinations &amp; travel photos coming soon.</p>
    </div>

    <!-- Off the clock -->
    <div class="block">
      <h3 class="block-h reveal">Off the clock</h3>
      <div class="passion-grid">
        {passions.items.map((p, i) => (
          <article class="passion reveal" data-delay={(i % 4) + 1}>
            <h4 class="passion-h">{p.title}</h4>
            <p class="passion-b">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .block { margin-top: clamp(3rem, 7vh, 5rem); }
  .block:first-of-type { margin-top: clamp(2.5rem, 6vh, 4rem); }
  .block-h {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 360;
    font-style: italic;
    color: var(--accent-hi);
    margin-bottom: 1.6rem;
  }
  .block-intro { color: var(--text-dim); max-width: 52ch; margin-bottom: 1.6rem; font-size: var(--step-1); }

  /* — Volunteering — */
  .vol-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.4rem);
  }
  .vol {
    padding: clamp(1.3rem, 2.5vw, 1.8rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(160deg, rgba(30,26,19,0.5), rgba(18,15,11,0.3));
    transition: border-color 0.4s var(--ease), transform 0.4s var(--ease);
  }
  .vol:hover { border-color: var(--line-strong); transform: translateY(-4px); }
  .vol-period {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .vol-role { margin-top: 0.8rem; font-size: var(--step-1); font-weight: 400; line-height: 1.2; }
  .vol-org { margin-top: 0.3rem; color: var(--accent); font-size: var(--step--1); }
  .vol-blurb { margin-top: 0.9rem; color: var(--text-dim); font-size: var(--step-0); line-height: 1.5; }

  /* — Travel — */
  .travel-strip {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .place {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(30,26,19,0.4);
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .place:hover { border-color: var(--accent); transform: translateY(-3px); }
  .pin {
    width: 9px; height: 9px; border-radius: 50% 50% 50% 0;
    rotate: -45deg;
    background: var(--ember);
    box-shadow: 0 0 10px rgba(233,161,75,0.5);
    flex: none;
  }
  .place-name { font-size: var(--step-0); color: var(--text); }
  .place-note { font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); }
  .edit-hint { margin-top: 1.2rem; font-family: var(--font-mono); font-size: var(--step--1); color: var(--faint); }

  /* — Passions — */
  .passion-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2vw, 1.4rem);
  }
  .passion {
    padding-top: 1.3rem;
    border-top: 1px solid var(--line-strong);
  }
  .passion-h { font-size: var(--step-1); font-weight: 400; color: var(--text); }
  .passion-b { margin-top: 0.6rem; color: var(--text-dim); font-size: var(--step-0); line-height: 1.5; }

  @media (max-width: 860px) {
    .vol-grid { grid-template-columns: 1fr; }
    .passion-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .passion-grid { grid-template-columns: 1fr; }
  }
</style>
