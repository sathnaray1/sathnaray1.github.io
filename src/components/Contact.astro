---
import { profile } from "../data/content";
const year = new Date().getFullYear();
---

<section class="section contact" id="contact">
  <div class="contact-glow" aria-hidden="true"></div>
  <div class="wrap">
    <p class="eyebrow reveal" data-num="07">Contact</p>
    <h2 class="contact-title reveal">
      Let&rsquo;s build<br /><span class="accent-text">what&rsquo;s next.</span>
    </h2>
    <p class="contact-lead reveal" data-delay="1">
      Open to senior product leadership roles. If you&rsquo;re working on something
      ambitious in AI, analytics, or experimentation — I&rsquo;d love to talk.
    </p>

    <div class="email-row reveal" data-delay="2">
      <a class="contact-email" href={`mailto:${profile.email}`} data-cursor-hover>
        {profile.email}
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <button class="copy-btn" data-copy={profile.email} type="button" aria-label="Copy email address" data-cursor-hover>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M5 15V5a2 2 0 0 1 2-2h10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        <span class="copy-label">Copy</span>
      </button>
    </div>

    <div class="connect-row reveal" data-delay="3">
      <a class="connect" href={profile.linkedin} target="_blank" rel="noopener noreferrer" data-magnetic data-cursor-hover>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C21.4 8.65 22 11.3 22 14.4V21h-4v-5.8c0-1.38-.02-3.16-1.93-3.16-1.93 0-2.22 1.5-2.22 3.06V21h-4z"/></svg>
        LinkedIn
      </a>
      <a class="connect" href={profile.github} target="_blank" rel="noopener noreferrer" data-magnetic data-cursor-hover>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.48v-1.7c-2.78.62-3.37-1.2-3.37-1.2-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.32 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9v2.82c0 .27.18.59.69.48A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"/></svg>
        GitHub
      </a>
      <a class="connect" href={profile.instagram} target="_blank" rel="noopener noreferrer" data-magnetic data-cursor-hover>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg>
        Instagram
      </a>
      <a class="connect connect-resume" href={profile.resume} download data-magnetic data-cursor-hover>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Download résumé
      </a>
    </div>
  </div>

  <footer class="footer">
    <div class="wrap footer-row">
      <span class="foot-brand"><span class="foot-mark">SN</span> {profile.name}</span>
      <span class="foot-meta">&copy; {year} · Built with care &amp; Astro</span>
      <a class="foot-top" href="#top" data-cursor-hover>Back to top ↑</a>
    </div>
  </footer>
</section>

<style>
  .contact {
    position: relative;
    text-align: center;
    padding-block: clamp(6rem, 14vh, 11rem) 0;
    overflow: hidden;
  }
  .contact-glow {
    position: absolute;
    bottom: 10%; left: 50%;
    width: 80vw; height: 50vh;
    translate: -50% 0;
    background: radial-gradient(circle, rgba(233,161,75,0.16), transparent 62%);
    filter: blur(50px);
    pointer-events: none;
  }
  .contact .eyebrow { justify-content: center; }
  .contact-title {
    font-size: var(--step-4);
    font-weight: 350;
    line-height: 1.0;
    margin-top: 1.4rem;
    letter-spacing: -0.03em;
  }
  .contact-lead {
    margin: 1.8rem auto 0;
    max-width: 48ch;
    color: var(--text-dim);
    font-size: var(--step-1);
  }
  .email-row {
    margin-top: 2.8rem;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .contact-email {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1rem + 2.4vw, 3rem);
    font-weight: 360;
    letter-spacing: -0.02em;
    color: var(--text);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.3rem;
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .contact-email svg { transition: transform 0.3s var(--ease); }
  .contact-email:hover { color: var(--accent-hi); border-color: var(--accent); }
  .contact-email:hover svg { transform: translateX(5px); }
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    cursor: pointer;
    transition: border-color 0.3s var(--ease), color 0.3s var(--ease), background 0.3s var(--ease);
  }
  .copy-btn:hover { border-color: var(--accent); color: var(--text); }
  .copy-btn.is-copied { background: var(--ember); color: #1a1206; border-color: transparent; }

  .connect-row {
    margin-top: 2.2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
  }
  .connect {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.03em;
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease), background 0.3s var(--ease);
  }
  .connect:hover { color: var(--text); border-color: var(--accent); background: rgba(233,161,75,0.07); }
  .connect-resume { color: var(--text); border-color: var(--accent); }
  .connect-resume:hover { background: var(--ember); color: #1a1206; border-color: transparent; }

  .footer {
    margin-top: clamp(5rem, 12vh, 9rem);
    border-top: 1px solid var(--line);
    padding-block: 1.6rem;
  }
  .footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .foot-brand { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--text-dim); }
  .foot-mark {
    display: grid; place-items: center;
    width: 24px; height: 24px; border-radius: 6px;
    background: var(--ember); color: #1a1206;
    font-size: 0.7rem; font-weight: 500;
  }
  .foot-top { transition: color 0.3s var(--ease); }
  .foot-top:hover { color: var(--accent); }

  @media (max-width: 560px) {
    .footer-row { justify-content: center; text-align: center; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const email = btn.dataset.copy || "";
      const label = btn.querySelector(".copy-label");
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        const ta = document.createElement("textarea");
        ta.value = email; document.body.appendChild(ta); ta.select();
        try { document.execCommand("copy"); } catch {}
        ta.remove();
      }
      btn.classList.add("is-copied");
      if (label) label.textContent = "Copied!";
      setTimeout(() => {
        btn.classList.remove("is-copied");
        if (label) label.textContent = "Copy";
      }, 1600);
    });
  });
</script>
